{
  "name": "dshell",
  "private": true,
  "version": "0.1.0",
  "description": "Tabbed desktop shell for DeepSeek Harness — one binary, tabs on top of the unmodified DSH web UI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node tools/build-ui.mjs --dev",
    "build:ui": "node tools/build-ui.mjs",
    "build": "node tools/build-ui.mjs && node tools/make-icons.mjs && node tools/cargo.mjs build --release",
    "icons": "node tools/render-icons.mjs && node tools/make-icons.mjs",
    "binary": "node tools/package-binary.mjs",
    "app": "node tools/cargo.mjs run",
    "test": "node tools/cargo.mjs test",
    "test:bridge": "node --test tools/content-bridge.test.mjs",
    "test:version": "node --test tools/version.test.mjs",
    "check": "node tools/cargo.mjs clippy --all-targets -- -D warnings",
    "probe": "node tools/dsh-contract-probe.mjs",
    "version": "node tools/set-version.mjs",
    "version:check": "node tools/check-version.mjs",
    "bundle:linux": "node tools/build-ui.mjs && tauri build --bundles appimage",
    "bundle:mac": "node tools/build-ui.mjs && tauri build --target universal-apple-darwin --bundles app,dmg"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/cli": "^2.12.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
