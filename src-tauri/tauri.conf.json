{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dshell",
  "version": "0.1.0",
  "identifier": "dev.dshell.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["chrome"],
      "assetProtocol": {
        "enable": false
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": false,
    "targets": [],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
